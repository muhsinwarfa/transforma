# ─── Supabase ─────────────────────────────────────────────────────────────────
# Public (safe for the browser): used by the request-scoped RLS client.
NEXT_PUBLIC_SUPABASE_URL= 
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# by the Render Background Worker. RLS-exempt — guarded by DB triggers + the
# SECURITY DEFINER tenant-scoping functions.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=


# ─── Anthropic (worker only — narrative synthesis) ────────────────────────────
# Real Anthropic API. Writer model claude-opus-4-8; gate/judge model
# claude-sonnet-4-6. Never logged. Never exposed to the browser.
ANTHROPIC_API_KEY=

# ─── Audit ────────────────────────────────────────────────────────────────────
# Server secret for the tamper-resistant audit hash chain (keyed HMAC-SHA256).
# Rotating this breaks verification of pre-rotation entries — treat as long-lived.
AUDIT_CHAIN_KEY=

# ─── App ──────────────────────────────────────────────────────────────────────
APP_BASE_URL=http://localhost:3000
NODE_ENV=development
